---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import FriendLinkList from '../../islands/FriendLinkList.vue';
import ScrollProgress from '../../components/common/ScrollProgress.astro';
import { buildCss, getDefaultSettings } from '../../utils/settings';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
  canonicalUrl?: string;
  friendLinks?: boolean;
}

const {
  title,
  description = '',
  keywords = [],
  ogImage,
  canonicalUrl,
  friendLinks = true,
} = Astro.props;

const fullCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;

// SSR 阶段预拉取 settings 并内联 CSS 变量 —— 解决"必须刷新才能看到背景图"：
// 之前只客户端异步 fetch，首屏 SSR 渲染的是默认渐变 / 默认色，JS 起来后才覆盖；
// 现在直接把用户的 settings 烤进首屏 <style>，首屏就与客户端一致。
const host = Astro.url.hostname;
const isProdOrigin = host && host !== 'localhost' && host !== '127.0.0.1' && !host.endsWith('.local');
let initialSettings = getDefaultSettings();
if (isProdOrigin) {
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 800);
    const res = await fetch(`${Astro.url.origin}/api/v1/settings`, { signal: ctrl.signal });
    clearTimeout(t);
    const data = await res.json();
    if (data?.code === 0 && data.data) initialSettings = data.data;
  } catch {
    /* 拉取失败/超时则回退默认，buildCss 仍能产出合法 CSS，不影响首屏 */
  }
}
const initialCss = buildCss(initialSettings);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title data-site-title>{title}</title>
    <meta name="description" content={description} data-page-set={description ? 'true' : ''} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={fullCanonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={fullCanonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
        else document.documentElement.setAttribute('data-theme', 'light');
        const l = localStorage.getItem('locale');
        if (l) document.documentElement.setAttribute('data-locale', l);
        else document.documentElement.setAttribute('data-locale', navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en');
      })();
    </script>
    <ClientRouter />
    {/* SSR 阶段预内联 settings 生成的 CSS 变量；客户端 initSettings 会用同一 ID 覆盖，保持单一来源 */}
    <style id="dynamic-settings" set:html={initialCss}></style>
  </head>
  <body>
    <div class="site-bg" data-parallax-fixed aria-hidden="true"></div>
    <ScrollProgress />
    <header class="site-header">
      <nav class="header-nav container">
        <a href="/" class="site-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span id="site-logo-text">Blog</span>
        </a>
        <div class="nav-links">
          <a href="/" data-i18n="nav.home">首页</a>
          <a href="/articles" data-i18n="nav.articles">文章</a>
          <a href="/archives" data-i18n="nav.archives">归档</a>
          <a href="/about" data-i18n="nav.about">关于</a>
        </div>
        <div class="nav-actions">
          <a href="/search" class="nav-icon" aria-label="搜索" data-feature="search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </a>
          <button class="nav-icon" id="locale-toggle-btn" aria-label="切换语言" title="中文/English" data-feature="i18n">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </button>
          <button class="nav-icon" id="theme-toggle-btn" aria-label="切换主题" data-feature="darkMode">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="page-layout">
      <div class="main-content">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      {friendLinks && (
        <div class="container footer-friend-links" data-feature="friendLinks">
          <FriendLinkList client:load variant="footer" />
        </div>
      )}
      <div class="container footer-inner">
        <p id="footer-text">&copy; {new Date().getFullYear()} Blog</p>
        <a href="/rss.xml" data-feature="rss">RSS</a>
      </div>
    </footer>

    <button class="back-to-top" id="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
    </button>

    <!-- 全局悬浮一言组件：可拖动、位置记忆、点击展开一言卡片 -->
    <hitokoto-widget>
      <button class="hk-btn" type="button" aria-label="一言" title="一言">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </button>
      <div class="hk-card" role="dialog" aria-label="一言" hidden>
        <p class="hk-text">加载中…</p>
        <div class="hk-meta">
          <span class="hk-from"></span>
          <button class="hk-refresh" type="button" aria-label="换一句" title="换一句">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          </button>
        </div>
      </div>
    </hitokoto-widget>

    <script>
      // ===== 主题 / 语言：localStorage 持久化 + 事件委托 + 跨页恢复 =====
      const THEME_KEY = 'theme';
      const LOCALE_KEY = 'locale';

      function resolveTheme() {
        const s = localStorage.getItem(THEME_KEY);
        if (s === 'light' || s === 'dark') return s;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      function resolveLocale() {
        const s = localStorage.getItem(LOCALE_KEY);
        if (s === 'zh' || s === 'en') return s;
        return navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
      }
      // 从 localStorage 恢复 html 属性 —— ClientRouter 导航会清空 data-theme / data-locale
      function syncThemeLocale() {
        document.documentElement.setAttribute('data-theme', resolveTheme());
        document.documentElement.setAttribute('data-locale', resolveLocale());
        updateThemeIcon();
      }

      const SUN_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
      const MOON_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';
      // 主题图标跟随当前主题：亮色显示月亮（点击进入暗色），暗色显示太阳
      function updateThemeIcon() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        btn.innerHTML = dark ? SUN_SVG : MOON_SVG;
      }

      // 事件委托：绑定在 document 上，页面切换（DOM 替换）后依然有效
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const btn = t.closest ? t.closest('#theme-toggle-btn, #locale-toggle-btn') : null;
        if (!btn) return;
        if (btn.id === 'theme-toggle-btn') {
          const next = resolveTheme() === 'dark' ? 'light' : 'dark';
          localStorage.setItem(THEME_KEY, next);
          document.documentElement.setAttribute('data-theme', next);
          updateThemeIcon();
        } else if (btn.id === 'locale-toggle-btn') {
          const next = resolveLocale() === 'zh' ? 'en' : 'zh';
          setLocaleAndRefresh(next);
        }
      });

      async function setLocaleAndRefresh(locale: string) {
        try {
          const { setLocale, refreshDomTranslations } = await import('../../utils/i18n');
          setLocale(locale as 'zh' | 'en');
          refreshDomTranslations();
        } catch {}
      }

      // ===== 动态标签标题：离开挽留 / 回来欢迎（visibilitychange，document 级监听跨页有效）=====
      (() => {
        const AWAY_MSG = '/(ㄒoㄒ)/~~ 不要走嘛';
        const BACK_MSG = 'ヾ(≧▽≦*)o 欢迎回来～';
        const TITLES = [AWAY_MSG, BACK_MSG];
        let restoreTimer: number | undefined;

        // 记录页面自己的标题（跳过文案态，避免把文案当原标题）
        const snapshotTitle = () => {
          if (!TITLES.includes(document.title)) {
            (window as any).__blogOrigTitle = document.title;
          }
        };

        snapshotTitle();
        // ClientRouter 跨页后标题已被 Astro 更新，刷新快照
        document.addEventListener('astro:page-load', () => {
          if (!document.hidden) snapshotTitle();
        });

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            // 离开：持续显示挽留语
            window.clearTimeout(restoreTimer);
            if (document.title !== AWAY_MSG) {
              snapshotTitle();
              document.title = AWAY_MSG;
            }
          } else {
            // 回来：先短暂显示欢迎语，再恢复原标题
            window.clearTimeout(restoreTimer);
            document.title = BACK_MSG;
            restoreTimer = window.setTimeout(() => {
              if (!document.hidden) document.title = (window as any).__blogOrigTitle || document.title;
            }, 1800);
          }
        });
      })();

      // 首屏：应用存储的主题 / 语言 + 刷新静态翻译
      syncThemeLocale();
      (async () => {
        try {
          const { initLocale, refreshDomTranslations } = await import('../../utils/i18n');
          initLocale();
          refreshDomTranslations();
        } catch {}
      })();

      // ClientRouter 导航后：html 属性被新文档同步清空，这里恢复（after-swap 尽早恢复，page-load 兜底）
      document.addEventListener('astro:after-swap', () => syncThemeLocale());
      document.addEventListener('astro:page-load', () => {
        syncThemeLocale();
        (async () => {
          try {
            const { refreshDomTranslations } = await import('../../utils/i18n');
            refreshDomTranslations();
          } catch {}
        })();
      });

      (async function() {
        try {
          const res = await fetch('/api/v1/config');
          const data = await res.json();
          if (data.code !== 0 || !data.data) return;
          const cfg = data.data;

          const logoText = document.getElementById('site-logo-text');
          if (logoText && cfg.site_title) logoText.textContent = cfg.site_title;

          const footerText = document.getElementById('footer-text');
          if (footerText && cfg.site_title) footerText.textContent = `\u00A9 ${new Date().getFullYear()} ${cfg.site_title}`;

          const titleEl = document.querySelector('title[data-site-title]');
          if (titleEl) {
            const current = titleEl.textContent || '';
            if (current === '首页' && cfg.site_title) {
              titleEl.textContent = cfg.site_title;
            } else if (cfg.site_title) {
              titleEl.textContent = current.replace('Blog', cfg.site_title);
            }
          }

          const metaDesc = document.querySelector('meta[name="description"]');
          if (metaDesc && !metaDesc.getAttribute('data-page-set') && cfg.site_description) {
            metaDesc.setAttribute('content', cfg.site_description);
          }

          const ogDesc = document.querySelector('meta[property="og:description"]');
          if (ogDesc && !metaDesc?.getAttribute('data-page-set') && cfg.site_description) {
            ogDesc.setAttribute('content', cfg.site_description);
          }

          const heroTitle = document.getElementById('hero-site-title');
          if (heroTitle && cfg.site_title) heroTitle.textContent = cfg.site_title;

          const heroSubtitle = document.getElementById('hero-site-subtitle');
          if (heroSubtitle && cfg.site_subtitle) heroSubtitle.textContent = cfg.site_subtitle;

          const heroDesc = document.getElementById('hero-site-desc');
          if (heroDesc && cfg.site_description) heroDesc.textContent = cfg.site_description;
        } catch {}
      })();

      // 拉取并套用后台可视化配置（配色/布局/背景/功能开关/文案覆盖）
      (async () => {
        try {
          const { initSettings } = await import('../../utils/settings');
          initSettings();
        } catch {}
      })();

      // 初始化全站动效（reveal / 磁吸 / 进度条 / 视差）；ClientRouter 跨页后重挂
      (async () => {
        try {
          const { initMotion } = await import('../../utils/motion');
          let teardown: (() => void) | null = null;
          const startMotion = () => {
            teardown?.();
            teardown = initMotion();
          };
          startMotion();
          document.addEventListener('astro:page-load', startMotion);
        } catch {}
      })();

      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        const onScroll = () => {
          backToTop.classList.toggle('show', window.scrollY > 600);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      // ===== 全局悬浮一言组件：可拖动 + 位置记忆 + 跨页复原 =====
      (() => {
        const POS_KEY = 'hitokoto-widget-pos';
        const API_URL = 'https://api.furry.ist/hitokoto/';

        class HitokotoWidget extends HTMLElement {
          connectedCallback() {
            if ((this as any)._inited) return;
            (this as any)._inited = true;

            const root = this;
            const btn = root.querySelector('.hk-btn') as HTMLButtonElement;
            const card = root.querySelector('.hk-card') as HTMLElement;
            const textEl = root.querySelector('.hk-text') as HTMLElement;
            const fromEl = root.querySelector('.hk-from') as HTMLElement;
            const refreshBtn = root.querySelector('.hk-refresh') as HTMLButtonElement;
            if (!btn || !card) return;

            // ---- 位置：localStorage 记忆，默认右下 ----
            let pos: { x: number; y: number } | null = null;
            try { pos = JSON.parse(localStorage.getItem(POS_KEY) || 'null'); } catch {}
            if (!pos || typeof pos.x !== 'number' || typeof pos.y !== 'number') pos = { x: 88, y: 84 };
            const apply = (p: { x: number; y: number }) => {
              root.style.left = p.x + '%';
              root.style.top = p.y + '%';
            };
            apply(pos);
            const readPos = () => {
              const x = parseFloat(root.style.left) || 88;
              const y = parseFloat(root.style.top) || 84;
              return { x, y };
            };

            // ---- 边界约束：组件（含展开的卡片）必须完整落在视口内，越界弹回最近合法位置 ----
            const MARGIN = 8;
            const ensureInView = () => {
              const br = btn.getBoundingClientRect();
              const rects = [br];
              if (!card.hidden) rects.push(card.getBoundingClientRect());
              const top = Math.min(...rects.map((r) => r.top));
              const bottom = Math.max(...rects.map((r) => r.bottom));
              const left = Math.min(...rects.map((r) => r.left));
              const right = Math.max(...rects.map((r) => r.right));
              const vw = window.innerWidth, vh = window.innerHeight;
              // 顶部禁区 = 固定导航栏高度 + 留白：组件（含展开卡片）不得进入导航栏区域
              const headerEl = document.querySelector('.site-header');
              const topMin = (headerEl ? headerEl.getBoundingClientRect().height : 0) + MARGIN;
              let dx = 0, dy = 0;
              if (top < topMin) dy = topMin - top;
              else if (bottom > vh - MARGIN) dy = (vh - MARGIN) - bottom;
              if (left < MARGIN) dx = MARGIN - left;
              else if (right > vw - MARGIN) dx = (vw - MARGIN) - right;
              if (dx || dy) {
                const p = readPos();
                apply({
                  x: Math.min(97, Math.max(3, p.x + (dx / vw) * 100)),
                  y: Math.min(97, Math.max(3, p.y + (dy / vh) * 100))
                });
                return true;
              }
              return false;
            };
            (this as any)._ensureInView = ensureInView;

            // 卡片默认在按钮上方展开；上方空间不足时翻转到按钮下方，保证卡片不进视口外
            const updateCardSide = () => {
              const headerEl = document.querySelector('.site-header');
              const topMin = (headerEl ? headerEl.getBoundingClientRect().height : 0) + MARGIN;
              const spaceAbove = btn.getBoundingClientRect().top - topMin;
              const cardH = card.offsetHeight || 130;
              root.classList.toggle('card-below', spaceAbove < cardH + 16);
            };

            // ---- 拖动：pointer 事件，位移 > 6px 视为拖动；拖动过程实时弹回视口内 ----
            let dragging = false;
            let moved = 0;
            let sx = 0, sy = 0, spx = 0, spy = 0;
            btn.addEventListener('pointerdown', (e) => {
              dragging = true;
              moved = 0;
              sx = e.clientX; sy = e.clientY;
              const p = readPos(); spx = p.x; spy = p.y;
              btn.setPointerCapture(e.pointerId);
            });
            btn.addEventListener('pointermove', (e) => {
              if (!dragging) return;
              const dx = e.clientX - sx, dy = e.clientY - sy;
              moved = Math.max(moved, Math.abs(dx), Math.abs(dy));
              const nx = Math.min(97, Math.max(3, spx + (dx / window.innerWidth) * 100));
              const ny = Math.min(97, Math.max(3, spy + (dy / window.innerHeight) * 100));
              root.style.left = nx + '%';
              root.style.top = ny + '%';
              ensureInView();
            });
            const endDrag = (e: PointerEvent) => {
              if (!dragging) return;
              dragging = false;
              if (moved <= 6) {
                toggleCard();
              } else {
                ensureInView();
                try { localStorage.setItem(POS_KEY, JSON.stringify(readPos())); } catch {}
              }
            };
            btn.addEventListener('pointerup', endDrag);
            btn.addEventListener('pointercancel', endDrag);

            // ---- 一言内容 ----
            let loading = false;
            const load = async (force: boolean) => {
              if (loading) return;
              if (!force && textEl.textContent && textEl.textContent !== '加载中…') return;
              loading = true;
              textEl.textContent = '加载中…';
              fromEl.textContent = '';
              const ctrl = new AbortController();
              const timer = window.setTimeout(() => ctrl.abort(), 8000);
              try {
                // api.furry.ist 在部分地区直连会触发证书/安全警告（被墙/SNI 干扰），强制走本站代理
                const res = await window.fetchWithProxy(API_URL, { headers: { Accept: 'application/json' }, signal: ctrl.signal }, { forceProxy: true });
                if (!res.ok) throw new Error('http ' + res.status);
                const data = await res.json();
                const d = (data && typeof data === 'object' && data.data && typeof data.data === 'object') ? data.data : data;
                const t = (d && typeof d.hitokoto === 'string' && d.hitokoto.trim()) ? d.hitokoto.trim() : '';
                if (!t) throw new Error('empty');
                textEl.textContent = t;
                const src = (d && typeof d.from === 'string' && d.from.trim()) ? d.from.trim() : '';
                const who = (d && typeof d.from_who === 'string' && d.from_who.trim()) ? d.from_who.trim() : '';
                fromEl.textContent = src ? (who ? `${src} —— ${who}` : src) : '';
              } catch {
                textEl.textContent = '一言获取失败，点刷新重试';
              } finally {
                window.clearTimeout(timer);
                loading = false;
              }
            };

            const toggleCard = () => {
              const show = card.hidden;
              if (show) {
                updateCardSide();
                card.hidden = false;
                ensureInView();
                load(false);
              } else {
                card.hidden = true;
              }
            };
            refreshBtn.addEventListener('click', () => load(true));
            ensureInView();
          }
        }
      // ===== 外链文字/接口内容自动降级代理：fetch 直连失败（网络/CORS/非 2xx）→ 本站 /api/v1/text-proxy 兜底 =====
      // 用法：const res = await window.fetchWithProxy('https://外部接口/xxx', { headers: {...} });
      // 返回标准 Response；调用方仅作文本/JSON 解析，勿 innerHTML 注入（防 XSS）。
      (window as any).fetchWithProxy = async (input: RequestInfo | URL, init?: RequestInit, opts?: { forceProxy?: boolean }): Promise<Response> => {
        const target = typeof input === 'string' ? input : (input instanceof URL ? input.href : (input as Request).url);
        // forceProxy：目标域名已被证实会在用户浏览器直连时触发证书/安全警告（如被墙、SNI 干扰的接口），
        // 直接走本站代理，浏览器从不直连目标，从源头避免「不安全」提示。
        if (!opts || !opts.forceProxy) {
          let res: Response | null = null;
          try {
            res = await fetch(input, init);
            if (res.ok) return res; // 直连成功：直接返回，不影响体验
          } catch {
            /* 网络/CORS 失败，进入代理兜底 */
          }
        }
        // 代理请求不携带原 signal：直连因超时中断时仍需走代理（Worker 端自带 10s 超时保护）
        const proxyUrl = location.origin + '/api/v1/text-proxy?url=' + encodeURIComponent(target);
        try {
          return await fetch(proxyUrl, {
            method: 'GET',
            headers: { Accept: (init && init.headers && (init.headers as any).Accept) || 'application/json,text/plain,*/*' },
          });
        } catch {
          return new Response(JSON.stringify({ code: 502, message: '代理兜底失败', data: null }), {
            status: 502,
            headers: { 'Content-Type': 'application/json' },
          });
        }
      };

      // ===== 外链图片自动降级代理：直连失败（防盗链/失效）→ 本站 /api/v1/img-proxy 兜底 =====
      (() => {
        const PROXY_PREFIX = '/api/v1/img-proxy?url=';
        document.addEventListener('error', (e) => {
          const t = e.target as HTMLImageElement | null;
          if (!t || !(t instanceof HTMLImageElement)) return;
          // 用 t.src（绝对 URL）判断：currentSrc 可能在失败时被清空，getAttribute 会读到相对路径
          const src = t.currentSrc || t.src || '';
          if (!src || !/^https?:\/\//i.test(src)) return;
          if (src.includes('/api/v1/img-proxy')) {
            // 代理也失败：隐藏图片占位，避免破图破坏布局
            if (!t.dataset.proxyFailed) {
              t.dataset.proxyFailed = '1';
              t.style.visibility = 'hidden';
            }
            return;
          }
          if (t.dataset.proxyDone) return;
          let u: URL;
          try { u = new URL(src, location.href); } catch { return; }
          if (u.origin === location.origin) return; // 本站资源无需代理
          t.dataset.proxyDone = '1';
          t.src = PROXY_PREFIX + encodeURIComponent(src);
        }, true);
      })();

        if (!customElements.get('hitokoto-widget')) customElements.define('hitokoto-widget', HitokotoWidget);

        // 视口尺寸变化（旋转/缩放窗口）时，把当前页组件弹回视口内
        window.addEventListener('resize', () => {
          const w = document.querySelector('hitokoto-widget') as any;
          if (w && w._inited && typeof w._ensureInView === 'function') w._ensureInView();
        });
      })();
    </script>
  </body>
</html>

