---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import FriendLinkList from '../../islands/FriendLinkList.vue';
import ScrollProgress from '../../components/common/ScrollProgress.astro';
import { buildCss, getDefaultSettings } from '../../utils/settings';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
  canonicalUrl?: string;
  friendLinks?: boolean;
}

const {
  title,
  description = '',
  keywords = [],
  ogImage,
  canonicalUrl,
  friendLinks = true,
} = Astro.props;

const fullCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;

// SSR 阶段预拉取 settings 并内联 CSS 变量 —— 解决"必须刷新才能看到背景图"：
// 之前只客户端异步 fetch，首屏 SSR 渲染的是默认渐变 / 默认色，JS 起来后才覆盖；
// 现在直接把用户的 settings 烤进首屏 <style>，首屏就与客户端一致。
const host = Astro.url.hostname;
const isProdOrigin = host && host !== 'localhost' && host !== '127.0.0.1' && !host.endsWith('.local');
let initialSettings = getDefaultSettings();
if (isProdOrigin) {
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 800);
    const res = await fetch(`${Astro.url.origin}/api/v1/settings`, { signal: ctrl.signal });
    clearTimeout(t);
    const data = await res.json();
    if (data?.code === 0 && data.data) initialSettings = data.data;
  } catch {
    /* 拉取失败/超时则回退默认，buildCss 仍能产出合法 CSS，不影响首屏 */
  }
}
const initialCss = buildCss(initialSettings);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title data-site-title>{title}</title>
    <meta name="description" content={description} data-page-set={description ? 'true' : ''} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={fullCanonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={fullCanonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
        else document.documentElement.setAttribute('data-theme', 'light');
        const l = localStorage.getItem('locale');
        if (l) document.documentElement.setAttribute('data-locale', l);
        else document.documentElement.setAttribute('data-locale', navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en');
      })();
    </script>
    <ClientRouter />
    {/* SSR 阶段预内联 settings 生成的 CSS 变量；客户端 initSettings 会用同一 ID 覆盖，保持单一来源 */}
    <style id="dynamic-settings" set:html={initialCss}></style>
  </head>
  <body>
    <div class="site-bg" data-parallax-fixed aria-hidden="true"></div>
    <ScrollProgress />
    <header class="site-header">
      <nav class="header-nav container">
        <a href="/" class="site-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span id="site-logo-text">Blog</span>
        </a>
        <div class="nav-links">
          <a href="/" data-i18n="nav.home">首页</a>
          <a href="/articles" data-i18n="nav.articles">文章</a>
          <a href="/archives" data-i18n="nav.archives">归档</a>
          <a href="/about" data-i18n="nav.about">关于</a>
        </div>
        <div class="nav-actions">
          <a href="/search" class="nav-icon" aria-label="搜索" data-feature="search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </a>
          <button class="nav-icon" id="locale-toggle-btn" aria-label="切换语言" title="中文/English" data-feature="i18n">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </button>
          <button class="nav-icon" id="theme-toggle-btn" aria-label="切换主题" data-feature="darkMode">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="page-layout">
      <div class="main-content">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      {friendLinks && (
        <div class="container footer-friend-links" data-feature="friendLinks">
          <FriendLinkList client:load variant="footer" />
        </div>
      )}
      <div class="container footer-inner">
        <p id="footer-text">&copy; {new Date().getFullYear()} Blog</p>
        <a href="/rss.xml" data-feature="rss">RSS</a>
      </div>
    </footer>

    <button class="back-to-top" id="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
    </button>

    <script>
      // ===== 主题 / 语言：localStorage 持久化 + 事件委托 + 跨页恢复 =====
      const THEME_KEY = 'theme';
      const LOCALE_KEY = 'locale';

      function resolveTheme() {
        const s = localStorage.getItem(THEME_KEY);
        if (s === 'light' || s === 'dark') return s;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      function resolveLocale() {
        const s = localStorage.getItem(LOCALE_KEY);
        if (s === 'zh' || s === 'en') return s;
        return navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
      }
      // 从 localStorage 恢复 html 属性 —— ClientRouter 导航会清空 data-theme / data-locale
      function syncThemeLocale() {
        document.documentElement.setAttribute('data-theme', resolveTheme());
        document.documentElement.setAttribute('data-locale', resolveLocale());
        updateThemeIcon();
      }

      const SUN_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
      const MOON_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';
      // 主题图标跟随当前主题：亮色显示月亮（点击进入暗色），暗色显示太阳
      function updateThemeIcon() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        btn.innerHTML = dark ? SUN_SVG : MOON_SVG;
      }

      // 事件委托：绑定在 document 上，页面切换（DOM 替换）后依然有效
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const btn = t.closest ? t.closest('#theme-toggle-btn, #locale-toggle-btn') : null;
        if (!btn) return;
        if (btn.id === 'theme-toggle-btn') {
          const next = resolveTheme() === 'dark' ? 'light' : 'dark';
          localStorage.setItem(THEME_KEY, next);
          document.documentElement.setAttribute('data-theme', next);
          updateThemeIcon();
        } else if (btn.id === 'locale-toggle-btn') {
          const next = resolveLocale() === 'zh' ? 'en' : 'zh';
          setLocaleAndRefresh(next);
        }
      });

      async function setLocaleAndRefresh(locale: string) {
        try {
          const { setLocale, refreshDomTranslations } = await import('../../utils/i18n');
          setLocale(locale as 'zh' | 'en');
          refreshDomTranslations();
        } catch {}
      }

      // 首屏：应用存储的主题 / 语言 + 刷新静态翻译
      syncThemeLocale();
      (async () => {
        try {
          const { initLocale, refreshDomTranslations } = await import('../../utils/i18n');
          initLocale();
          refreshDomTranslations();
        } catch {}
      })();

      // ClientRouter 导航后：html 属性被新文档同步清空，这里恢复（after-swap 尽早恢复，page-load 兜底）
      document.addEventListener('astro:after-swap', () => syncThemeLocale());
      document.addEventListener('astro:page-load', () => {
        syncThemeLocale();
        (async () => {
          try {
            const { refreshDomTranslations } = await import('../../utils/i18n');
            refreshDomTranslations();
          } catch {}
        })();
      });

      (async function() {
        try {
          const res = await fetch('/api/v1/config');
          const data = await res.json();
          if (data.code !== 0 || !data.data) return;
          const cfg = data.data;

          const logoText = document.getElementById('site-logo-text');
          if (logoText && cfg.site_title) logoText.textContent = cfg.site_title;

          const footerText = document.getElementById('footer-text');
          if (footerText && cfg.site_title) footerText.textContent = `\u00A9 ${new Date().getFullYear()} ${cfg.site_title}`;

          const titleEl = document.querySelector('title[data-site-title]');
          if (titleEl) {
            const current = titleEl.textContent || '';
            if (current === '首页' && cfg.site_title) {
              titleEl.textContent = cfg.site_title;
            } else if (cfg.site_title) {
              titleEl.textContent = current.replace('Blog', cfg.site_title);
            }
          }

          const metaDesc = document.querySelector('meta[name="description"]');
          if (metaDesc && !metaDesc.getAttribute('data-page-set') && cfg.site_description) {
            metaDesc.setAttribute('content', cfg.site_description);
          }

          const ogDesc = document.querySelector('meta[property="og:description"]');
          if (ogDesc && !metaDesc?.getAttribute('data-page-set') && cfg.site_description) {
            ogDesc.setAttribute('content', cfg.site_description);
          }

          const heroTitle = document.getElementById('hero-site-title');
          if (heroTitle && cfg.site_title) heroTitle.textContent = cfg.site_title;

          const heroSubtitle = document.getElementById('hero-site-subtitle');
          if (heroSubtitle && cfg.site_subtitle) heroSubtitle.textContent = cfg.site_subtitle;

          const heroDesc = document.getElementById('hero-site-desc');
          if (heroDesc && cfg.site_description) heroDesc.textContent = cfg.site_description;
        } catch {}
      })();

      // 拉取并套用后台可视化配置（配色/布局/背景/功能开关/文案覆盖）
      (async () => {
        try {
          const { initSettings } = await import('../../utils/settings');
          initSettings();
        } catch {}
      })();

      // 初始化全站动效（reveal / 磁吸 / 进度条 / 视差）；ClientRouter 跨页后重挂
      (async () => {
        try {
          const { initMotion } = await import('../../utils/motion');
          let teardown: (() => void) | null = null;
          const startMotion = () => {
            teardown?.();
            teardown = initMotion();
          };
          startMotion();
          document.addEventListener('astro:page-load', startMotion);
        } catch {}
      })();

      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        const onScroll = () => {
          backToTop.classList.toggle('show', window.scrollY > 600);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: rgba(250, 250, 250, 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    z-index: 100;
  }
  [data-theme="dark"] .site-header {
    background: rgba(10, 10, 10, 0.8);
  }
  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-primary);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .site-logo:hover {
    color: var(--color-accent);
  }
  .site-logo svg {
    color: var(--color-accent);
  }
  .nav-links {
    display: flex;
    gap: 0.25rem;
  }
  .nav-links a {
    padding: 0.4rem 0.95rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 999px;
    transition: all var(--transition-fast);
  }
  .nav-links a:hover {
    color: #ffffff;
    background: var(--color-accent);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }
  .nav-icon:hover {
    color: #ffffff;
    background: var(--color-accent);
  }
  /* 主题切换按钮：点击时图标旋转，呼应整页渐变 */
  .nav-icon#theme-toggle-btn svg {
    transition: transform var(--motion-duration-base) var(--motion-ease-standard);
  }
  .nav-icon#theme-toggle-btn:active svg {
    transform: rotate(180deg);
  }
  @media (max-width: 767px) {
    .nav-links { display: none; }
  }
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.5rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(73, 177, 245, 0.35);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity var(--transition-normal), transform var(--transition-normal), background var(--transition-fast);
    z-index: 90;
  }
  .back-to-top.show {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .back-to-top:hover {
    background: var(--color-accent-hover);
  }
  [data-theme="dark"] .back-to-top {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  .site-footer {
    padding: 2rem 0;
    margin-top: 6rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
  }
  .footer-inner a {
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
  }
  .footer-inner a:hover {
    color: var(--color-accent);
  }

  /* 主题/语言切换时的整页平滑交叉（背景图随之渐变） */
  @keyframes site-vt-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: site-vt-fade var(--transition-fast, 0.15s) ease both;
  }
</style>
