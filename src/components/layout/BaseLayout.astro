---
import '../../styles/global.css';
// 响应式层放最后：覆盖 global.css 的固定 padding，同时仍早于页面 scoped 样式
import '../../styles/responsive.css';
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import { ClientRouter } from 'astro:transitions';
import FriendLinkList from '../../islands/FriendLinkList.vue';
import ScrollProgress from '../../components/common/ScrollProgress.astro';
import { buildCss, getDefaultSettings } from '../../utils/settings';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
  /** 文章页传 `article`，其余页面保持默认 `website`。 */
  ogType?: 'website' | 'article';
  /** `og:type=article` 时的 ISO 8601 发布时间。 */
  publishedTime?: string;
  canonicalUrl?: string;
  friendLinks?: boolean;
}

const {
  title,
  description = '',
  keywords = [],
  ogImage,
  ogType = 'website',
  publishedTime,
  canonicalUrl,
  friendLinks = true,
} = Astro.props;

const fullCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;

// SSR 阶段预拉取 settings 并内联 CSS 变量 —— 解决"必须刷新才能看到背景图"：
// 之前只客户端异步 fetch，首屏 SSR 渲染的是默认渐变 / 默认色，JS 起来后才覆盖；
// 现在直接把用户的 settings 烤进首屏 <style>，首屏就与客户端一致。
const host = Astro.url.hostname;
const isProdOrigin = host && host !== 'localhost' && host !== '127.0.0.1' && !host.endsWith('.local');
let initialSettings = getDefaultSettings();
if (isProdOrigin) {
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 800);
    const res = await fetch(`${Astro.url.origin}/api/v1/settings/public`, { signal: ctrl.signal });
    clearTimeout(t);
    const data = await res.json();
    if (data?.code === 0 && data.data) initialSettings = data.data;
  } catch {
    /* 拉取失败/超时则回退默认，buildCss 仍能产出合法 CSS，不影响首屏 */
  }
}
const initialCss = buildCss(initialSettings);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title data-site-title>{title}</title>
    <meta name="description" content={description} data-page-set={description ? 'true' : ''} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={fullCanonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={fullCanonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
        else document.documentElement.setAttribute('data-theme', 'light');
        const l = localStorage.getItem('locale');
        if (l) document.documentElement.setAttribute('data-locale', l);
        else document.documentElement.setAttribute('data-locale', navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en');
      })();
    </script>
    <noscript>
      <style is:inline>
        /* 无 JS 时 reveal 元素不能停留在初始 opacity: 0，保证正文/标题可读 */
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <ClientRouter />
    {/* SSR 阶段预内联 settings 生成的 CSS 变量；客户端 initSettings 会用同一 ID 覆盖，保持单一来源 */}
    <style id="dynamic-settings" set:html={initialCss}></style>
  </head>
  <body>
    <div class="site-bg" data-parallax-fixed aria-hidden="true"></div>
    <ScrollProgress />
    <header class="site-header">
      <nav class="header-nav container">
        <a href="/" class="site-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span id="site-logo-text">Blog</span>
        </a>
        <div class="nav-links" id="site-nav">
          <a href="/" data-i18n="nav.home">首页</a>
          <a href="/articles" data-i18n="nav.articles">文章</a>
          <a href="/categories" data-i18n="nav.categories">分类</a>
          <a href="/tags" data-i18n="nav.tags">标签</a>
          <a href="/archives" data-i18n="nav.archives">归档</a>
          <a href="/about" data-i18n="nav.about">关于</a>
        </div>
        <div class="nav-actions">
          <a href="/search" class="nav-icon" aria-label="搜索" data-feature="search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </a>
          <button class="nav-icon" id="locale-toggle-btn" aria-label="切换语言" title="中文/English" data-feature="i18n">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </button>
          <button class="nav-icon" id="theme-toggle-btn" aria-label="切换主题" data-feature="darkMode">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          </button>
          <button class="nav-icon nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" title="菜单">
            <span class="sr-only" data-i18n="nav.menu">菜单</span>
            <svg class="nav-icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
            <svg class="nav-icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="page-layout">
      <div class="main-content">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      {friendLinks && (
        <div class="container footer-friend-links" data-feature="friendLinks">
          <FriendLinkList client:load variant="footer" />
        </div>
      )}
      <div class="container footer-inner">
        <p id="footer-text">&copy; {new Date().getFullYear()} Blog</p>
        <div class="footer-links">
          <a href="/privacy" data-i18n="nav.privacy">隐私</a>
          <a href="/rss.xml" data-feature="rss">RSS</a>
        </div>
      </div>
    </footer>

    <button class="back-to-top" id="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
    </button>

    <!-- 全局悬浮一言组件：可拖动、位置记忆、点击展开一言卡片 -->
    <hitokoto-widget>
      <button class="hk-btn" type="button" aria-label="一言" title="一言">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </button>
      <div class="hk-card" role="dialog" aria-label="一言" hidden>
        <p class="hk-text">加载中…</p>
        <div class="hk-meta">
          <span class="hk-from"></span>
          <button class="hk-refresh" type="button" aria-label="换一句" title="换一句">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          </button>
        </div>
      </div>
    </hitokoto-widget>

    <script>
      // issue #103 / L4：内联脚本只做编排，具体逻辑在 src/scripts/layout/* 里
      // （每个模块可单独单测；改一处不必再读 600 行内联代码）。
      import { initThemeLocale } from '../../scripts/layout/theme-locale';
      import { initMobileNav } from '../../scripts/layout/mobile-nav';
      import { initDynamicTitle } from '../../scripts/layout/dynamic-title';
      import { initSiteConfig } from '../../scripts/layout/site-config';
      import { initSiteSettings } from '../../scripts/layout/site-settings';
      import { initMotionBoot } from '../../scripts/layout/motion-boot';
      import { initBackToTop } from '../../scripts/layout/back-to-top';
      import { initFetchWithProxy } from '../../scripts/layout/fetch-proxy';
      import { initHitokotoWidget } from '../../scripts/layout/hitokoto';
      import { initImgProxyFallback } from '../../scripts/layout/img-proxy-fallback';
      import { initFaviconLight } from '../../scripts/layout/favicon-light';

      // 顺序与拆分前一致：主题/语言 → 导航 → 标题 → 站点配置 → 后台配置 → 动效
      // → 回到顶部 → 代理挂载 → 一言（注册自定义元素）→ 图片兜底 → 图标。
      // 代理必须早于一言注册：一言的内容请求走 window.fetchWithProxy。
      initThemeLocale();
      initMobileNav();
      initDynamicTitle();
      initSiteConfig();
      void initSiteSettings();
      void initMotionBoot();
      initBackToTop();
      initFetchWithProxy();
      initHitokotoWidget();
      initImgProxyFallback();
      initFaviconLight();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--header-height) + env(safe-area-inset-top, 0px));
    padding-top: env(safe-area-inset-top, 0px);
    background: rgba(250, 250, 250, 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    z-index: 100;
  }
  [data-theme="dark"] .site-header {
    background: rgba(10, 10, 10, 0.8);
  }
  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 100%;
    min-width: 0;
  }
  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--color-text-primary);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .site-logo:hover {
    color: var(--color-accent);
  }
  .site-logo svg {
    flex: none;
    color: var(--color-accent);
  }
  #site-logo-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .nav-links {
    display: flex;
    flex-shrink: 0;
    gap: 0.25rem;
  }
  .nav-links a {
    padding: 0.4rem 0.95rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 999px;
    transition: all var(--transition-fast);
  }
  .nav-links a:hover {
    color: #ffffff;
    background: var(--color-accent);
  }
  /* taxonomy v2（#81）：六项导航在 768–1024px 收窄间距，不隐藏分类 / 标签 */
  @media (min-width: 768px) and (max-width: 1024px) {
    .nav-links a {
      padding: 0.4rem 0.6rem;
    }
  }
  .nav-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }
  .nav-icon:hover {
    color: #ffffff;
    background: var(--color-accent);
  }
  /* 移动端汉堡按钮：默认隐藏，仅窄屏出现 */
  .nav-toggle {
    display: none;
  }
  .nav-icon-close {
    display: none;
  }
  .nav-toggle[aria-expanded="true"] .nav-icon-menu {
    display: none;
  }
  .nav-toggle[aria-expanded="true"] .nav-icon-close {
    display: block;
  }
  /* 主题切换按钮：点击时图标旋转，呼应整页渐变 */
  .nav-icon#theme-toggle-btn svg {
    transition: transform var(--motion-duration-base) var(--motion-ease-standard);
  }
  .nav-icon#theme-toggle-btn:active svg {
    transform: rotate(180deg);
  }
  @media (max-width: 767px) {
    .nav-toggle {
      display: flex;
    }
    .nav-links {
      position: fixed;
      top: calc(var(--header-height) + env(safe-area-inset-top, 0px));
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      gap: 0.15rem;
      max-height: calc(
        100dvh - var(--header-height) - env(safe-area-inset-top, 0px)
      );
      overflow-y: auto;
      padding: 0.5rem max(1rem, env(safe-area-inset-left, 0px))
        calc(0.9rem + env(safe-area-inset-bottom, 0px));
      background: rgba(250, 250, 250, 0.97);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
      border-bottom: 1px solid var(--color-border-light);
      box-shadow: var(--shadow-lg);
    }
    [data-theme="dark"] .nav-links {
      background: rgba(10, 10, 10, 0.97);
    }
    .site-header.nav-open .nav-links {
      display: flex;
    }
    .nav-links a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0.65rem 0.9rem;
      border-radius: var(--radius-md);
      font-size: 0.95rem;
    }
    .nav-links a:hover {
      color: var(--color-accent);
      background: var(--color-accent-subtle);
    }
  }
  @media (max-width: 479px) {
    .header-nav {
      gap: 0.35rem;
    }
    .site-logo {
      gap: 0.375rem;
      font-size: 1rem;
    }
    .site-logo svg {
      width: 18px;
      height: 18px;
    }
    #site-logo-text {
      /* 给右侧 4 个操作按钮留出空间，超长站点名省略而不是换行 */
      max-width: 26vw;
    }
    .nav-actions {
      gap: 0;
    }
    .nav-icon {
      width: 40px;
      height: 40px;
    }
  }
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.5rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(73, 177, 245, 0.35);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity var(--transition-normal), transform var(--transition-normal), background var(--transition-fast);
    z-index: 90;
  }
  .back-to-top.show {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .back-to-top:hover {
    background: var(--color-accent-hover);
  }
  [data-theme="dark"] .back-to-top {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  @media (max-width: 767px) {
    .back-to-top {
      right: max(0.75rem, env(safe-area-inset-right, 0px));
      bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
      width: 44px;
      height: 44px;
    }
  }
  .site-footer {
    padding: clamp(1.5rem, 4vw, 2rem) 0;
    padding-bottom: calc(clamp(1.5rem, 4vw, 2rem) + env(safe-area-inset-bottom, 0px));
    margin-top: clamp(3rem, 8vw, 6rem);
    /* 底部文字同样叠背景，加同款轻磨砂衬底保证可读 */
    background: color-mix(in srgb, var(--color-bg-primary) 74%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(1.15);
    backdrop-filter: blur(10px) saturate(1.15);
    /* 配合 body flex：不被压缩，始终贴底 */
    flex-shrink: 0;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .footer-inner a {
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
  }
  .footer-inner a:hover {
    color: var(--color-accent);
  }
  @media (max-width: 479px) {
    .footer-inner {
      flex-direction: column;
      justify-content: center;
      text-align: center;
    }
    .footer-links {
      justify-content: center;
      gap: 0.25rem;
    }
    .footer-inner a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.5rem;
    }
  }

  /* 主题/语言切换时的整页平滑交叉（背景图随之渐变） */
  @keyframes site-vt-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: site-vt-fade var(--transition-fast, 0.15s) ease both;
  }
</style>
