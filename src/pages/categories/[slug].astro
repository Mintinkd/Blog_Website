---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import {
  loadTaxonomyForPage,
  type TaxonomyArticle,
  type TaxonomyItem,
  type TaxonomyResult,
} from '../../utils/taxonomyServer.ts';
import { renderArticleCards, renderPagination } from '../../utils/taxonomyRender.ts';
  import { ssrLocaleIsZh, bindPagination } from '@/scripts/layout/taxonomy-helpers';
import {
  parseTagParam,
  renderFilterChips,
  renderFilteredEmpty,
  resolveActiveTagSlug,
} from '../../utils/taxonomyFilter.ts';

export const prerender = false;

const { slug } = Astro.params || {};
const categorySlug = slug ?? '';
const basePath = `/categories/${encodeURIComponent(categorySlug)}`;
const requestedTag = parseTagParam(Astro.url.search);

// issue #117：?tag= 由服务端解析并校验归属；合法时 SSR 直接输出筛选后的文章。
// 带筛选时先取本分类标签、再取文章（必须先校验）；不带筛选时两者并行，
// 常规分类页不引入串行往返。
let activeTagSlug: string | null = null;
let tagsResult: TaxonomyResult;
let loaded: TaxonomyResult;
if (requestedTag) {
  tagsResult = await loadTaxonomyForPage('tags', { categorySlug });
  const categoryTags = tagsResult.status === 'ok' ? tagsResult.items as TaxonomyItem[] : [];
  activeTagSlug = resolveActiveTagSlug(categoryTags, requestedTag);
  loaded = await loadTaxonomyForPage('category-articles', {
    slug: categorySlug,
    tagSlug: activeTagSlug ?? undefined,
  });
} else {
  [tagsResult, loaded] = await Promise.all([
    loadTaxonomyForPage('tags', { categorySlug }),
    loadTaxonomyForPage('category-articles', { slug: categorySlug }),
  ]);
}

const items = loaded.status === 'ok' ? loaded.items as TaxonomyArticle[] : [];
const totalPages = loaded.status === 'ok' ? loaded.totalPages : 1;
const knownTags = tagsResult.status === 'ok' ? tagsResult.items as TaxonomyItem[] : [];
const filterChips = renderFilterChips(basePath, knownTags, activeTagSlug, '全部');
// error 时不写首屏内容（留空由客户端接管并显示加载失败），避免误导性「暂无文章」
const firstHtml = loaded.status === 'error'
  ? ''
  : activeTagSlug && items.length === 0
    ? renderFilteredEmpty(basePath, '该标签暂无文章', '清除筛选')
    : renderArticleCards(items, { read: '阅读', noArticles: '暂无文章', belongsLabel: '分类：' });
const firstPagination = renderPagination(1, totalPages, { prev: '上一页', next: '下一页' });
---

<BaseLayout title={`分类: ${slug}`} description="">
  <section class="category-page">
    <nav class="breadcrumb" id="category-breadcrumb" aria-label="breadcrumb">
      <a href="/">{'首页'}</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span id="category-breadcrumb-current">{slug}</span>
    </nav>
    <div class="page-header">
      <h1 class="page-title" id="category-title" data-i18n="page.category" data-i18n-params={JSON.stringify({ name: slug })}>分类: {slug}</h1>
      <a href="/articles" class="page-back" data-i18n="page.all_articles">← 所有文章</a>
    </div>
    <p id="category-desc" class="category-desc-full" hidden></p>

    <!-- taxonomy v2（#81 §5）：标签筛选条；#117 起服务端渲染 <a> chip（无 JS 可用） -->
    <div id="category-tag-filter" class="category-tag-filter" hidden={knownTags.length === 0}>
      <span class="filter-label" data-i18n="taxonomy.filter_by_tag">按标签筛选</span>
      <div class="filter-chips" id="category-filter-chips"><Fragment set:html={filterChips} /></div>
    </div>

    <div id="article-list" data-category-slug={categorySlug} data-page="1" data-page-size="10" data-active-tag={activeTagSlug ?? ''} data-ssr={loaded.status === 'ok' || loaded.status === 'empty' ? '1' : '0'}>
      <div class="article-list-inner"><Fragment set:html={firstHtml} /></div>
      <div id="pagination-mount"><Fragment set:html={firstPagination} /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    margin-bottom: 0.75rem;
    min-width: 0;
  }
  .breadcrumb a {
    color: var(--color-text-tertiary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-accent);
  }
  .breadcrumb-sep {
    opacity: 0.6;
  }
  .category-desc-full {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    line-height: 1.6;
    margin-bottom: clamp(0.75rem, 2vw, 1rem);
    overflow-wrap: anywhere;
  }
  .category-tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: clamp(1rem, 3vw, 1.5rem);
    min-width: 0;
  }
  .category-tag-filter[hidden] {
    display: none;
  }
  .filter-label {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-width: 0;
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 36px;
    padding: 0.2rem 0.7rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.8rem;
    cursor: pointer;
    overflow-wrap: anywhere;
    transition: all var(--transition-fast);
  }
  .filter-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filter-chip[aria-current="page"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .filter-chip .tag-count {
    font-size: 0.7rem;
    opacity: 0.8;
  }
  .category-not-found {
    text-align: center;
    padding: clamp(2rem, 6vw, 3.5rem) 0;
  }
  .category-not-found h2 {
    font-size: 1.2rem;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }
  .category-not-found a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .category-not-found a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filtered-empty {
    text-align: center;
    color: var(--color-text-tertiary);
    padding: 2.5rem 0;
  }
  .filtered-empty button,
  .filtered-empty a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.75rem;
    padding: 0.4rem 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    cursor: pointer;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .filtered-empty button:hover,
  .filtered-empty a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .page-header {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
  }

  .page-title {
    min-width: 0;
    font-size: var(--page-title-size);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .page-back {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    transition: color var(--transition-fast);
  }

  .page-back:hover {
    color: var(--color-accent);
  }

  .article-list-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>

<script>
  import { t, getLocale, initLocale } from '../../utils/i18n.ts';
  import { renderArticleCards, renderPagination } from '../../utils/taxonomyRender.ts';
  import { ssrLocaleIsZh, bindPagination } from '@/scripts/layout/taxonomy-helpers';
  import { escapeHtml, safePathSegment } from '../../utils/escape.ts';
  import {
    parseTagParam,
    buildTagFilterUrl,
    buildCategoryArticlesQuery,
    renderFilterChips,
    renderFilteredEmpty,
    resolveActiveTagSlug,
    type FilterChipTag,
  } from '../../utils/taxonomyFilter.ts';

  const wrapper = document.getElementById('article-list');
  const basePath = '/categories/' + safePathSegment(wrapper?.dataset.categorySlug ?? '');

  /** 当前标签筛选（null = 「全部」）；首屏取服务端已校验的 SSR 值。 */
  let activeTagSlug: string | null = wrapper?.dataset.activeTag || null;
  /** 本分类名下的标签（slug → name/article_count），用于校验 ?tag= 合法性。 */
  let knownTags: FilterChipTag[] = [];

  async function loadArticles(page = 1, tagSlug: string | null = activeTagSlug) {
    const container = document.querySelector('.article-list-inner');
    if (!container || !wrapper) return;

    const categorySlug = wrapper.dataset.categorySlug;
    const locale = getLocale();
    const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

    try {
      const query = buildCategoryArticlesQuery({
        categorySlug: categorySlug ?? '',
        tagSlug,
        page,
      });
      const response = await fetch(`/api/v1/articles?${query}`);
      const data = await response.json();

      if (data.code === 0 && data.data) {
        const { items, total_pages } = data.data;

        if (items.length === 0 && tagSlug) {
          // #81 §5 / #117：筛选后空结果 → 提示 + 清除筛选链接（无 JS 也能回「全部」）
          container.innerHTML = renderFilteredEmpty(
            basePath,
            t('page.no_articles_tag'),
            t('taxonomy.clear_filter')
          );
          bindClearFilter();
          const paginationMount = document.getElementById('pagination-mount');
          if (paginationMount) paginationMount.innerHTML = '';
          return;
        }

        container.innerHTML = renderArticleCards(items, {
          read: t('article.read'),
          noArticles: t('page.no_articles_category'),
          belongsLabel: t('taxonomy.belongs_to_category'),
        }, dateLocale, false);
        if (items.length === 0) return;

        const paginationMount = document.getElementById('pagination-mount');
        if (paginationMount) {
          paginationMount.innerHTML = renderPagination(page, total_pages, {
            prev: t('page.prev'), next: t('page.next'),
          });
          bindPagination(loadArticles);
        }
      }
    } catch (e) {
      container.innerHTML = `<p style="text-align:center;color:var(--color-text-tertiary);padding:3rem 0;">${t('common.load_failed')}</p>`;
    }
  }

  // ── taxonomy v2（#81 §5）：标签筛选条与 URL 契约 ──

  function renderFilterChipsUi() {
    const chips = document.getElementById('category-filter-chips');
    if (!chips) return;
    chips.innerHTML = renderFilterChips(basePath, knownTags, activeTagSlug, t('taxonomy.all'));
  }

  /** 点击 chip / popstate 统一入口：更新 URL（pushState / replaceState）并重新取数。 */
  function selectTag(tagSlug: string | null, mode: 'push' | 'replace' = 'push') {
    activeTagSlug = tagSlug;
    const url = buildTagFilterUrl(basePath, tagSlug);
    if (mode === 'push') {
      history.pushState({ tag: tagSlug }, '', url);
    } else {
      history.replaceState({ tag: tagSlug }, '', url);
    }
    renderFilterChipsUi();
    loadArticles(1, tagSlug);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function bindFilterChips() {
    const chips = document.getElementById('category-filter-chips');
    if (!chips) return;
    chips.addEventListener('click', (e) => {
      // #117：chip 是 <a>——无 JS 时照常整页导航；有 JS 时拦截为 pushState + 局部刷新。
      const link = (e.target as HTMLElement).closest('a.filter-chip') as HTMLAnchorElement | null;
      if (!link) return;
      e.preventDefault();
      const slug = link.dataset.tag || null;
      if (slug === activeTagSlug) return;
      selectTag(slug);
    });
  }

  /** 筛选空态的「清除筛选」是 <a>（SSR 与客户端共用）；拦截为局部刷新。 */
  function bindClearFilter() {
    const link = document.getElementById('clear-tag-filter');
    if (!link || link.dataset.bound === '1') return;
    link.dataset.bound = '1';
    link.addEventListener('click', (e) => {
      e.preventDefault();
      selectTag(null);
    });
  }

  async function loadCategoryMeta() {
    if (!wrapper) return;
    const categorySlug = wrapper.dataset.categorySlug;
    const titleEl = document.getElementById('category-title');
    const currentEl = document.getElementById('category-breadcrumb-current');
    const descEl = document.getElementById('category-desc');
    const filterBox = document.getElementById('category-tag-filter');
    if (!categorySlug || !titleEl || !currentEl) return;

    try {
      const res = await fetch(`/api/v1/categories/${safePathSegment(categorySlug)}`);
      if (res.status === 404) {
        // 区分两种 404（同 /tags/:slug 的口径）：code 10005 = 资源真不存在 →
        // 渲染未找到；code 404 = worker 未部署新端点（部署窗口期）→ 跳过回填，
        // SSR 文章列表照常展示。
        const payload = await res.json().catch(() => null);
        if (payload?.code === 10005) {
          renderNotFound();
        }
        return;
      }
      const data = await res.json();
      if (data.code !== 0 || !data.data) return;
      const cat = data.data;
      const catName = cat.name || categorySlug;
      titleEl.textContent = catName;
      document.title = catName;
      currentEl.textContent = catName;
      if (cat.description && descEl) {
        descEl.textContent = cat.description;
        descEl.hidden = false;
      }
      // 标签筛选条：GET /tags?category_slug=<slug>
      const tagRes = await fetch(`/api/v1/tags?category_slug=${safePathSegment(categorySlug)}`);
      const tagData = tagRes.ok ? await tagRes.json() : { code: -1 };
      if (tagData.code === 0 && Array.isArray(tagData.data)) {
        knownTags = tagData.data.map((tg: any) => ({
          slug: tg.slug,
          name: tg.name,
          article_count: tg.article_count || 0,
        }));
        if (filterBox) filterBox.hidden = knownTags.length === 0;

        // URL 契约：非法 / 不属于本分类的 ?tag= → 忽略、replaceState 清参，
        // 且不发无效筛选请求（SSR 已按「全部」渲染时无需再取数）。
        const requested = parseTagParam(window.location.search);
        const hasTagParam = new URLSearchParams(window.location.search).has('tag');
        const legal = resolveActiveTagSlug(knownTags, requested);
        const serverTag = wrapper.dataset.activeTag || null;
        activeTagSlug = legal;
        if (hasTagParam && !legal) {
          history.replaceState({ tag: null }, '', buildTagFilterUrl(basePath, null));
        }
        // SSR 已按同一筛选渲染过就不重复取数；SSR 失败或状态不同才由客户端接管。
        if (wrapper.dataset.ssr !== '1' || serverTag !== legal) {
          loadArticles(1, legal);
        }

        renderFilterChipsUi();
        bindFilterChips();
        bindClearFilter();
        window.addEventListener('popstate', () => {
          const restored = parseTagParam(window.location.search);
          // 仅接受本分类名下的 tag；否则回「全部」
          const restoredLegal = resolveActiveTagSlug(knownTags, restored);
          activeTagSlug = restoredLegal;
          renderFilterChipsUi();
          loadArticles(1, restoredLegal);
        });
      }
    } catch (e) {
      // 元信息回填失败不影响文章列表
    }
  }

  function renderNotFound() {
    if (!wrapper) return;
    const section = wrapper.closest('.category-page') as HTMLElement | null;
    if (section) {
      wrapper.hidden = true;
      const filterBox = document.getElementById('category-tag-filter');
      if (filterBox) filterBox.hidden = true;
      const notFound = document.createElement('div');
      notFound.className = 'category-not-found';
      notFound.innerHTML = `
        <h2>${escapeHtml(t('page.category_not_found'))}</h2>
        <a href="/categories">${escapeHtml(t('nav.categories'))}</a>`;
      wrapper.after(notFound);
    }
  }

  // ssrLocaleIsZh / bindPagination 从 @/scripts/layout/taxonomy-helpers 导入（#112 item 12）
  // taxonomy v2（#81）：模块脚本跨导航常驻——pathname 不在 /categories/:slug 时让位
  // （/tags/:slug 与本页共用 #article-list 结构）。
  document.addEventListener('astro:page-load', () => {
    if (!location.pathname.startsWith('/categories/')) return;
    loadCategoryMeta();
    if (wrapper?.dataset.ssr === '1' && ssrLocaleIsZh()) {
      bindPagination(loadArticles);
      return;
    }
    initLocale();
    loadArticles();
  });

  document.addEventListener('locale-changed', () => {
    if (!location.pathname.startsWith('/categories/')) return;
    loadArticles();
  });
</script>

<style is:global>
  .list-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-normal);
  }
  .list-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-1px);
  }
  .list-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .list-card-body {
    padding: clamp(1rem, 2.4vw, 1.25rem) clamp(1rem, 3vw, 1.5rem);
  }
  .list-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    min-width: 0;
  }
  .list-card-category {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: none;
  }
  .list-card-category:hover {
    text-decoration: underline;
  }
  .list-card-date {
    color: var(--color-text-tertiary);
  }
  .list-card-title {
    font-size: clamp(1rem, 1.4vw, 1.05rem);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
    margin-bottom: 0.35rem;
    overflow-wrap: anywhere;
  }
  .list-card-summary {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }
  .list-card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.5rem;
    min-width: 0;
  }
  .list-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-width: 0;
  }
  .list-card-tag {
    padding: 0.1rem 0.5rem;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-sm);
    font-size: 0.72rem;
    text-decoration: none;
  }
  .list-card-tag[data-cross-category="1"] {
    border: 1px dashed var(--color-accent);
  }
  .list-card-stats {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 4vw, 2rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }
  .pag-btn {
    min-height: 44px;
    padding: 0.45rem 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .pag-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pag-info {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }
</style>
