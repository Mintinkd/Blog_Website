---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { loadTaxonomyForPage } from '../../utils/taxonomyServer.ts';
import { escapeHtml, safePathSegment } from '../../utils/escape.ts';

export const prerender = false;

// issue #97 / M17：服务端取数渲染首屏（方案 A），非 JS 抓取器可见；客户端脚本负责后续刷新。
const loaded = await loadTaxonomyForPage('categories');
const categories = loaded.status === 'ok' ? [...loaded.items].sort(
  (a: any, b: any) => (b.article_count || 0) - (a.article_count || 0)
) : [];
---

<BaseLayout title="分类" description="">
  <section class="categories-page">
    <div class="page-header">
      <h1 class="page-title" data-i18n="page.categories">分类</h1>
    </div>
    <p class="page-desc" data-i18n="page.categories_desc">按分类浏览所有文章</p>
    <div id="categories-cloud" class="categories-cloud" data-ssr={loaded.status !== 'error' ? '1' : '0'}>
      {loaded.status === 'ok' ? (
        <Fragment set:html={categories.map((cat: any) => `
          <a href="/categories/${safePathSegment(cat.slug)}" class="category-item">
            <div class="category-head">
              <span class="category-name">${escapeHtml(cat.name)}</span>
              <span class="category-count">${cat.article_count || 0} <span data-i18n="admin.article_count">篇文章</span></span>
            </div>
            ${cat.description ? `<span class="category-desc">${escapeHtml(cat.description)}</span>` : ''}
          </a>
        `).join('')} />
      ) : (
        <div class="categories-empty" data-i18n={loaded.status === 'error' ? 'common.load_failed' : 'page.no_categories'}>{loaded.status === 'error' ? '加载失败' : '暂无分类'}</div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-size: var(--page-title-size);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .page-desc {
    color: var(--color-text-tertiary);
    font-size: 0.9rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .categories-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.6rem, 2vw, 0.9rem);
  }
  .category-item {
    display: flex;
    flex: 1 1 220px;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(0.8rem, 2vw, 0.9rem) clamp(0.9rem, 2.5vw, 1.1rem);
    min-width: 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .category-item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }
  .category-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .category-name {
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }
  .category-item:hover .category-name {
    color: var(--color-accent);
  }
  .category-count {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }
  .category-desc {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    line-height: 1.5;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .categories-loading,
  .categories-empty {
    color: var(--color-text-tertiary);
    font-size: 0.9rem;
  }
</style>

<script>
  import { t, getLocale, initLocale } from '../../utils/i18n.ts';
  import { escapeHtml, safePathSegment } from '../../utils/escape.ts';

  async function loadCategories() {
    const container = document.getElementById('categories-cloud');
    if (!container) return;

    try {
      const response = await fetch('/api/v1/categories');
      const data = await response.json();

      if (data.code === 0 && data.data) {
        const categories = Array.isArray(data.data) ? data.data : (data.data.items || []);
        if (categories.length === 0) {
          container.innerHTML = `<p class="categories-empty">${t('page.no_categories')}</p>`;
          return;
        }

        // 按文章数降序
        categories.sort((a: any, b: any) => (b.article_count || 0) - (a.article_count || 0));

        container.innerHTML = categories.map((cat: any) => `
          <a href="/categories/${safePathSegment(cat.slug)}" class="category-item">
            <div class="category-head">
              <span class="category-name">${escapeHtml(cat.name)}</span>
              <span class="category-count">${cat.article_count || 0} ${t('admin.article_count')}</span>
            </div>
            ${cat.description ? `<span class="category-desc">${escapeHtml(cat.description)}</span>` : ''}
          </a>
        `).join('');
      } else {
        container.innerHTML = `<p class="categories-empty">${t('common.load_failed')}</p>`;
      }
    } catch (e) {
      container.innerHTML = `<p class="categories-empty">${t('common.load_failed')}</p>`;
    }
  }

  // issue #97：SSR 首屏已渲染（data-ssr=1）时跳过首次 fetch，避免重复请求与闪烁；
  // 语言切换仍刷新（文案/排序随 locale 变），SSR 未成功时首次照旧由客户端补齐。
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('categories-cloud');
    const stored = localStorage.getItem('locale');
    const ssrZh = stored ? stored === 'zh' : navigator.language.toLowerCase().startsWith('zh');
    if (container?.dataset.ssr === '1' && ssrZh) return;
    initLocale();
    loadCategories();
  });
  document.addEventListener('locale-changed', () => loadCategories());
</script>
