---
import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="文章列表" description="所有文章列表">
  <section class="articles-page">
    <div class="page-header">
      <h1 class="page-title" data-i18n="page.articles">所有文章</h1>
      <p class="page-desc" data-i18n="page.articles_desc">记录技术与生活的点滴</p>
    </div>
    <div id="article-list" data-page="1" data-page-size="10">
      <div class="article-list-inner"></div>
      <div id="pagination-mount"></div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--color-text-tertiary);
  }

  .article-list-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>

<script>
  import { t, getLocale } from '../../utils/i18n.ts';
  import { getCategoryColor, categoryBadgeVars, categoryGradVars, categoryNameVars } from '../../utils/categoryColors';

  async function loadArticles(page = 1) {
    const container = document.querySelector('.article-list-inner');
    if (!container) return;

    const locale = getLocale();
    const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

    try {
      const response = await fetch(`/api/v1/articles?page=${page}&status=published`);
      const data = await response.json();

      if (data.code === 0 && data.data) {
        const { items, total, total_pages } = data.data;

        if (items.length === 0) {
          container.innerHTML = `<p style="text-align:center;color:var(--color-text-tertiary);padding:3rem 0;">${t('article.no_articles')}</p>`;
          return;
        }

        const escAttr = (s: string) => String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

        container.innerHTML = items.map((article: any) => {
          const cat = article.category;
          const catColor = getCategoryColor(cat?.slug, cat?.name);
          const badgeVars = cat ? categoryBadgeVars(catColor) : '';
          const cover = article.cover_image
            ? `<div class="list-card-cover"><img src="${escAttr(article.cover_image)}" alt="" loading="lazy" /></div>`
            : `<div class="list-card-cover list-card-cover-grad" style="${categoryGradVars(catColor)}"><span class="list-cover-cat-name" style="${categoryNameVars(catColor)}">${cat?.name || '✦'}</span></div>`;
          return `
          <article class="list-card" data-reveal="fade-up">
            <a href="/articles/${article.slug}" class="list-card-link">
              ${cover}
              <div class="list-card-body">
                <div class="list-card-meta">
                  ${cat ? `<span class="list-card-category" style="${badgeVars}">${cat.name}</span>` : ''}
                  <span class="list-card-date">${article.published_at ? new Date(article.published_at).toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' }) : ''}</span>
                </div>
                <h3 class="list-card-title">${article.title}</h3>
                ${article.summary ? `<p class="list-card-summary">${article.summary}</p>` : ''}
                <div class="list-card-footer">
                  <div class="list-card-tags">
                    ${(article.tags || []).slice(0, 3).map((tag: any) => `<span class="list-card-tag">${tag.name}</span>`).join('')}
                  </div>
                  <span class="list-card-stats">${article.view_count || 0} ${t('article.read')}</span>
                </div>
              </div>
            </a>
          </article>`;
        }).join('');
        window.dispatchEvent(new CustomEvent('motion:refresh'));

        const paginationMount = document.getElementById('pagination-mount');
        if (paginationMount && total_pages > 1) {
          let pagHtml = '<div class="pagination">';
          if (page > 1) pagHtml += `<button class="pag-btn" data-page="${page - 1}">${t('page.prev')}</button>`;
          pagHtml += `<span class="pag-info">${page} / ${total_pages}</span>`;
          if (page < total_pages) pagHtml += `<button class="pag-btn" data-page="${page + 1}">${t('page.next')}</button>`;
          pagHtml += '</div>';
          paginationMount.innerHTML = pagHtml;

          paginationMount.querySelectorAll('.pag-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const p = parseInt((btn as HTMLElement).dataset.page || '1', 10);
              loadArticles(p);
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          });
        }
      }
    } catch (e) {
      container.innerHTML = `<p style="text-align:center;color:var(--color-text-tertiary);padding:3rem 0;">${t('article.load_error')}</p>`;
    }
  }

  loadArticles();

  document.addEventListener('locale-changed', () => loadArticles());
</script>

<style is:global>
  .list-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    transition: all var(--transition-normal);
  }

  .list-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-1px);
  }

  .list-card-cover {
    position: relative;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .list-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-duration-base, 0.32s) var(--motion-ease-standard, ease);
  }

  .list-card:hover .list-card-cover img {
    transform: scale(1.03);
  }

  .list-card-cover-grad {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--grad-l);
  }

  [data-theme="dark"] .list-card-cover-grad {
    background: var(--grad-d);
  }

  .list-cover-cat-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.9;
    color: var(--catname-l);
  }

  [data-theme="dark"] .list-cover-cat-name {
    color: var(--catname-d);
  }

  .list-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .list-card-body {
    padding: 1.5rem;
  }

  .list-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
  }

  .list-card-category {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    background: var(--cat-bg);
    color: var(--cat-fg);
    border: 1px solid var(--cat-bd);
    transition: filter var(--transition-fast);
  }

  [data-theme="dark"] .list-card-category {
    background: var(--cat-bg-d);
    color: var(--cat-fg-d);
    border-color: var(--cat-bd-d);
  }

  .list-card-category:hover {
    filter: brightness(0.9);
  }

  .list-card-date {
    color: var(--color-text-tertiary);
  }

  .list-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
    margin-bottom: 0.35rem;
  }

  .list-card-summary {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .list-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .list-card-tags {
    display: flex;
    gap: 0.35rem;
  }

  .list-card-tag {
    padding: 0.1rem 0.5rem;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-sm);
    font-size: 0.72rem;
    transition: all var(--transition-fast);
  }

  .list-card-tag:hover {
    background-color: var(--color-tag-hover-bg);
    color: var(--color-tag-hover-text);
  }

  .list-card-stats {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  .pag-btn {
    padding: 0.45rem 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .pag-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .pag-info {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }
</style>
