---
import BaseLayout from '../../components/layout/BaseLayout.astro';

export const prerender = false;

const { slug } = Astro.params;
---

<BaseLayout title="文章详情" description="">
  <article class="article-detail" id="article-detail" data-slug={slug}>
    <div class="article-loading">
      <div class="loading-spinner"></div>
      <p data-i18n="article.loading">加载文章中...</p>
    </div>
  </article>
</BaseLayout>

<style>
  .article-detail {
    max-width: 760px;
    margin: 0 auto;
  }

  .article-loading {
    text-align: center;
    color: var(--color-text-tertiary);
    padding: 5rem 0;
  }

  .loading-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    margin: 0 auto 1rem;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import { t, getLocale } from '../../utils/i18n.ts';
  import { getCategoryColor, categoryBadgeVars, categoryGradVars, categoryNameVars } from '../../utils/categoryColors';
  import { createApp } from 'vue';

  async function mountVueComponents(articleId: number, likeCount: number) {
    const likeMount = document.getElementById('like-button-mount');
    if (likeMount) {
      const { default: LikeButton } = await import('../../islands/LikeButton.vue');
      const app = createApp(LikeButton, { articleId, initialCount: likeCount });
      app.mount(likeMount);
    }

    const commentMount = document.getElementById('comment-section-mount');
    if (commentMount) {
      const { default: CommentSection } = await import('../../islands/CommentSection.vue');
      const app = createApp(CommentSection, { articleId });
      app.mount(commentMount);
    }
  }

  async function loadArticle() {
    const container = document.getElementById('article-detail');
    if (!container) return;

    const slug = container.dataset.slug;
    if (!slug) return;

    const locale = getLocale();
    const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

    try {
      const response = await fetch(`/api/v1/articles/${slug}`);
      const data = await response.json();

      if (data.code === 0 && data.data) {
        const article = data.data;

        document.title = `${article.title} | Blog`;

        const metaDesc = document.querySelector('meta[name="description"]');
        if (metaDesc) metaDesc.setAttribute('content', article.summary || article.title);

        let bodyHtml = article.content_html || '';
        if (!bodyHtml && article.content) {
          const { renderMarkdown } = await import('../../utils/markdown.ts');
          bodyHtml = renderMarkdown(article.content);
        }

        const escAttr = (s: string) => String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        const catColor = getCategoryColor(article.category?.slug, article.category?.name);
        const badgeVars = article.category ? categoryBadgeVars(catColor) : '';
        const banner = article.cover_image
          ? `<div class="article-banner"><img src="${escAttr(article.cover_image)}" alt="" /></div>`
          : `<div class="article-banner article-banner-grad" style="${categoryGradVars(catColor)}"><span class="banner-cat-name" style="${categoryNameVars(catColor)}">${article.category?.name || '✦'}</span></div>`;

        container.innerHTML = `
          <header class="article-header" data-reveal-stagger>
            ${banner}
            <div class="article-meta-top" data-reveal="fade-up">
              ${article.category ? `<a href="/categories/${article.category.slug}" class="article-category" style="${badgeVars}">${article.category.name}</a>` : ''}
              <span class="article-date">${article.published_at ? new Date(article.published_at).toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' }) : ''}</span>
            </div>
            <h1 class="article-title" data-reveal="fade-up">${article.title}</h1>
            ${article.summary ? `<p class="article-summary" data-reveal="fade-up">${article.summary}</p>` : ''}
            <div class="article-meta-bottom" data-reveal="fade-up">
              <span class="meta-item">${article.view_count} ${t('article.views')}</span>
              <span class="meta-item">${article.like_count} ${t('article.likes')}</span>
              <span class="meta-item">${article.reading_time || 1} ${t('article.minutes_read')}</span>
            </div>
            <div class="article-tags" data-reveal="fade-up">
              ${(article.tags || []).map((tag: any) => `<a href="/tags/${tag.slug}" class="article-tag">${tag.name}</a>`).join('')}
            </div>
          </header>
          <div class="article-content prose">${bodyHtml}</div>
          <div class="article-actions">
            <div id="like-button-mount" data-article-id="${article.id}"></div>
          </div>
          <div id="comment-section-mount"></div>
        `;

        window.dispatchEvent(new CustomEvent('motion:refresh'));
        enhanceCodeBlocks(container);
        enhanceMediaLinks(container);
        mountVueComponents(article.id, article.like_count || 0);
      } else {
        container.innerHTML = `<div class="article-not-found"><h2>${t('article.not_found')}</h2><p>${t('article.check_link')}</p><a href="/" class="back-link">${t('article.back_home')}</a></div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="article-not-found"><p>${t('article.load_error')}</p><a href="/" class="back-link">${t('article.back_home')}</a></div>`;
    }
  }

  function enhanceCodeBlocks(root: HTMLElement) {
    root.querySelectorAll('pre').forEach((pre) => {
      if ((pre as HTMLElement).dataset.enhanced) return;
      (pre as HTMLElement).dataset.enhanced = '1';
      const code = pre.querySelector('code');
      const langMatch = code?.className.match(/language-([\w+-]+)/);
      const lang = langMatch ? langMatch[1] : '';
      const bar = document.createElement('div');
      bar.className = 'code-bar';
      if (lang) {
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        bar.appendChild(label);
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = '复制';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code?.textContent || pre.textContent || '');
          btn.textContent = '已复制';
        } catch {
          btn.textContent = '复制失败';
        }
        setTimeout(() => (btn.textContent = '复制'), 1600);
      });
      bar.appendChild(btn);
      pre.prepend(bar);
    });
  }

  /* ===== 媒体链接增强：音频/视频链接 → 专属卡片 ===== */
  const MD_AUDIO_RE = /\.(mp3|wav|ogg|m4a|flac|aac)([?#].*)?$/i;
  const MD_VIDEO_RE = /\.(mp4|webm|mov|m3u8)([?#].*)?$/i;
  const MD_BILI_RE = /bilibili\.com\/video\/(BV[\w]+)/i;
  const MD_YT_RE = /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{11})/i;
  const MD_RATES = [1, 1.5, 2, 0.5];

  function mdFmt(s: number): string {
    if (!isFinite(s)) return '--:--';
    const m = Math.floor(s / 60);
    const ss = Math.floor(s % 60);
    return (m < 10 ? '0' + m : '' + m) + ':' + (ss < 10 ? '0' + ss : '' + ss);
  }

  function buildAudioCard(url: string, title: string): HTMLElement {
    const el = document.createElement('div');
    el.className = 'md-media md-audio';
    el.innerHTML = `
      <span class="md-audio-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17.5V6l10-2.2v10.2"/><circle cx="6.8" cy="17.5" r="2.8"/><circle cx="16.8" cy="14" r="2.8"/></svg></span>
      <div class="md-audio-main">
        <div class="md-audio-title"></div>
        <div class="md-audio-meta">音频 · <span class="md-dur">--:--</span></div>
        <div class="md-audio-bar">
          <div class="md-audio-track"><i></i></div>
          <span class="md-audio-time"><span class="md-cur">00:00</span> / <span class="md-dur2">--:--</span></span>
        </div>
      </div>
      <button class="md-rate" type="button" aria-label="播放倍速">1.0x</button>
      <button class="md-play" type="button" aria-label="播放">
        <svg class="p-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.9l11-6.5a1 1 0 0 0 0-1.8l-11-6.5A1 1 0 0 0 8 5.5z"/></svg>
        <svg class="s-icon" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1.2"/><rect x="14" y="5" width="4" height="14" rx="1.2"/></svg>
      </button>`;
    (el.querySelector('.md-audio-title') as HTMLElement).textContent = title;

    const audio = document.createElement('audio');
    audio.src = url;
    audio.preload = 'metadata';
    el.prepend(audio);

    const playBtn = el.querySelector<HTMLButtonElement>('.md-play')!;
    const rateBtn = el.querySelector<HTMLButtonElement>('.md-rate')!;
    const track = el.querySelector<HTMLElement>('.md-audio-track')!;
    const fill = track.querySelector('i')!;
    const cur = el.querySelector('.md-cur')!;
    const durEls = el.querySelectorAll('.md-dur, .md-dur2');
    let rateIdx = 0;

    audio.addEventListener('loadedmetadata', () => {
      durEls.forEach((d) => (d.textContent = mdFmt(audio.duration)));
    });
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) {
        fill.style.width = (audio.currentTime / audio.duration) * 100 + '%';
      }
      cur.textContent = mdFmt(audio.currentTime);
    });
    audio.addEventListener('ended', () => el.classList.remove('is-playing'));

    playBtn.addEventListener('click', () => {
      if (audio.paused) void audio.play();
      else audio.pause();
      el.classList.toggle('is-playing');
    });
    rateBtn.addEventListener('click', () => {
      rateIdx = (rateIdx + 1) % MD_RATES.length;
      audio.playbackRate = MD_RATES[rateIdx];
      rateBtn.textContent = MD_RATES[rateIdx] + 'x';
    });

    const seek = (clientX: number) => {
      if (!audio.duration) return;
      const rect = track.getBoundingClientRect();
      const pct = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      audio.currentTime = pct * audio.duration;
      fill.style.width = pct * 100 + '%';
      cur.textContent = mdFmt(audio.currentTime);
    };
    let dragging = false;
    track.addEventListener('click', (e) => seek((e as MouseEvent).clientX));
    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      track.setPointerCapture(e.pointerId);
      seek(e.clientX);
    });
    track.addEventListener('pointermove', (e) => {
      if (dragging) seek(e.clientX);
    });
    ['pointerup', 'pointercancel'].forEach((ev) =>
      track.addEventListener(ev, () => { dragging = false; })
    );

    return el;
  }

  function buildVideoCard(title: string, factory: () => HTMLElement): HTMLElement {
    const el = document.createElement('div');
    el.className = 'md-media md-video';
    el.innerHTML = `
      <div class="md-video-cover">
        <span class="md-video-label">视频</span>
        <button class="md-video-play" type="button" aria-label="播放">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.9l11-6.5a1 1 0 0 0 0-1.8l-11-6.5A1 1 0 0 0 8 5.5z"/></svg>
        </button>
      </div>
      <div class="md-video-title"></div>`;
    (el.querySelector('.md-video-title') as HTMLElement).textContent = title;

    const cover = el.querySelector<HTMLElement>('.md-video-cover')!;
    const playBtn = el.querySelector<HTMLButtonElement>('.md-video-play')!;
    const play = () => {
      const frame = factory();
      frame.className = 'md-video-frame';
      cover.replaceWith(frame);
    };
    playBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      play();
    });
    cover.addEventListener('click', play);
    return el;
  }

  function enhanceMediaLinks(root: HTMLElement) {
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('.prose a[href]'));
    links.forEach((a) => {
      if (a.dataset.mdEnhanced) return;
      const href = (a.getAttribute('href') || '').trim();
      if (!/^https?:\/\//i.test(href)) return;

      let kind: 'audio' | 'video-file' | 'bili' | 'yt' | null = null;
      let embedUrl = '';
      if (MD_AUDIO_RE.test(href)) kind = 'audio';
      else if (MD_VIDEO_RE.test(href)) kind = 'video-file';
      else {
        const bm = href.match(MD_BILI_RE);
        if (bm) {
          kind = 'bili';
          embedUrl = `https://player.bilibili.com/player.html?bvid=${bm[1]}&autoplay=1&high_quality=1`;
        } else {
          const ym = href.match(MD_YT_RE);
          if (ym) {
            kind = 'yt';
            embedUrl = `https://www.youtube.com/embed/${ym[1]}?autoplay=1`;
          }
        }
      }
      if (!kind) return;
      a.dataset.mdEnhanced = '1';

      const rawTitle = (a.textContent || '').trim();
      const title = rawTitle || decodeURIComponent(href.split('/').pop()?.split(/[?#]/)[0] || '媒体链接');

      let card: HTMLElement;
      if (kind === 'audio') {
        card = buildAudioCard(href, title);
      } else if (kind === 'video-file') {
        card = buildVideoCard(title, () => {
          const v = document.createElement('video');
          v.src = href;
          v.controls = true;
          v.autoplay = true;
          v.preload = 'metadata';
          return v;
        });
      } else {
        card = buildVideoCard(title, () => {
          const f = document.createElement('iframe');
          f.src = embedUrl;
          f.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
          f.allowFullscreen = true;
          return f;
        });
      }
      a.replaceWith(card);
    });
  }

  loadArticle();

  document.addEventListener('locale-changed', () => loadArticle());
</script>

<style is:global>
  .article-detail {
    --card-pad: 2rem;
    max-width: 760px;
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--card-pad);
    box-shadow: var(--shadow-md);
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-banner {
    margin: calc(-1 * var(--card-pad)) calc(-1 * var(--card-pad)) 1.5rem;
    border-radius: calc(var(--radius-lg) - 2px) calc(var(--radius-lg) - 2px) 0 0;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .article-banner img {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .article-category {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--cat-bg);
    color: var(--cat-fg);
    border: 1px solid var(--cat-bd);
    transition: filter var(--transition-fast);
  }

  [data-theme="dark"] .article-category {
    background: var(--cat-bg-d);
    color: var(--cat-fg-d);
    border-color: var(--cat-bd-d);
  }

  .article-category:hover {
    filter: brightness(0.9);
  }

  .article-banner-grad {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    background: var(--grad-l);
  }

  [data-theme="dark"] .article-banner-grad {
    background: var(--grad-d);
  }

  .banner-cat-name {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0.95;
    color: var(--catname-l);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.55), 0 0 26px rgba(255, 255, 255, 0.3);
  }

  [data-theme="dark"] .banner-cat-name {
    color: var(--catname-d);
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.5), 0 0 24px rgba(255, 255, 255, 0.2);
  }

  .article-date {
    color: var(--color-text-tertiary);
  }

  .article-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .article-summary {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .article-meta-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--color-text-tertiary);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-tag {
    padding: 0.15rem 0.6rem;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    transition: all var(--transition-fast);
  }

  .article-tag:hover {
    background-color: var(--color-tag-hover-bg);
    color: var(--color-tag-hover-text);
  }

  .article-actions {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  .article-not-found {
    text-align: center;
    padding: 4rem 0;
    color: var(--color-text-secondary);
  }

  .article-not-found h2 {
    font-size: 1.5rem;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .article-not-found p {
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background-color: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .back-link:hover {
    background-color: var(--color-accent-hover);
    color: #fff;
  }

  @media (max-width: 639px) {
    .article-detail {
      --card-pad: 1.25rem;
    }

    .article-title {
      font-size: 1.5rem;
    }
  }

  /* ===== 文章媒体卡片（音频/视频链接增强） ===== */
  .md-media {
    margin: 1.4rem 0;
    background: color-mix(in srgb, var(--color-bg-secondary) 90%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  /* ---- 音频卡片 ---- */
  .md-audio {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
  }
  .md-audio-icon {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-accent), #5b8cff);
    color: #fff;
    box-shadow: 0 3px 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .md-audio-icon svg {
    width: 19px;
    height: 19px;
  }
  .md-audio-main {
    flex: 1;
    min-width: 0;
  }
  .md-audio-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .md-audio-meta {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    margin-top: 2px;
    max-height: 1.3em;
    overflow: hidden;
    transition: max-height 0.22s ease, opacity 0.18s ease, margin 0.2s ease;
  }
  .md-audio.is-playing .md-audio-meta {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
  }
  .md-audio-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 6px;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.28s ease, opacity 0.22s ease;
  }
  .md-audio.is-playing .md-audio-bar {
    max-height: 24px;
    opacity: 1;
  }
  .md-audio-track {
    flex: 1;
    height: 5px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
    cursor: pointer;
  }
  .md-audio-track i {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--color-accent), #5b8cff);
    border-radius: 999px;
  }
  .md-audio-time {
    font-size: 0.72rem;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .md-play,
  .md-rate {
    flex: none;
    height: 40px;
    border: none;
    cursor: pointer;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .md-play {
    position: relative;
    width: 40px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 3px 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
    transition: background 0.2s, transform 0.2s;
  }
  .md-play:hover {
    background: var(--color-accent-hover);
    transform: scale(1.05);
  }
  .md-play svg {
    position: absolute;
    width: 17px;
    height: 17px;
    transition: opacity 0.15s, transform 0.2s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .md-play .p-icon {
    opacity: 1;
    transform: scale(1);
  }
  .md-play .s-icon {
    opacity: 0;
    transform: scale(0.4) rotate(-45deg);
  }
  .md-audio.is-playing .md-play .p-icon {
    opacity: 0;
    transform: scale(0.4) rotate(45deg);
  }
  .md-audio.is-playing .md-play .s-icon {
    opacity: 1;
    transform: scale(1);
  }
  .md-rate {
    min-width: 52px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s, transform 0.2s;
  }
