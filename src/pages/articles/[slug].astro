---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { buildArticlePageMeta } from '../../utils/articleMeta';
import {
  applyArticleResponseHeaders,
  httpStatusForArticleResult,
  loadArticleForPage,
} from '../../utils/articleServer';
import { renderMarkdownServer } from '../../utils/markdownServer';
import { loadSiteTitle } from '../../utils/siteTitleServer';
import {
  categoryBadgeVars,
  categoryGradVars,
  categoryNameVars,
  getCategoryColor,
} from '../../utils/categoryColors';
import { formatArticleDate } from '../../utils/articleDate';

export const prerender = false;

// 请求时直连 Worker API 取文章，正文在服务端渲染后随首屏返回。
// 客户端不再发起文章详情请求，也不做正文拼接；脚本只负责岛屿挂载与阅读增强。
const { slug } = Astro.params;
// 文章与站点标题并行取数：配置读取失败时 meta 构造回退默认站名，不阻断文章页。
// 访客请求交给取数接缝：Cookie 用于阅读量去重，响应头沿用上游 Set-Cookie。
const [result, siteTitle] = await Promise.all([
  slug
    ? loadArticleForPage(slug, { request: Astro.request })
    : Promise.resolve({ status: 'not-found' } as const),
  loadSiteTitle(),
]);

Astro.response.status = httpStatusForArticleResult(result);
applyArticleResponseHeaders(Astro.response.headers, result);

// 每篇文章自己的 head 元信息：canonical / og:image 都以 Astro.site 绝对化。
const seo = buildArticlePageMeta(result, {
  siteUrl: Astro.site ?? new URL(Astro.url.origin),
  siteTitle,
});

const article = result.status === 'ok' ? result.article : null;
const category = article?.category ?? null;
const tags = article?.tags ?? [];
const bodyHtml = article ? renderMarkdownServer(article.content) : '';
const publishedAt = article?.published_at ?? '';
const publishedLabel = publishedAt ? formatArticleDate(publishedAt) : '';
const categoryColor = getCategoryColor(category?.slug, category?.name);
const categoryBadgeStyle = category ? categoryBadgeVars(categoryColor) : '';
const categoryGradStyle = categoryGradVars(categoryColor);
const categoryNameStyle = categoryNameVars(categoryColor);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
  publishedTime={seo.publishedTime}
>
  {article ? (
    <article class="article-detail" id="article-detail">
      <header class="article-header" data-reveal-stagger>
        {article.cover_image ? (
          <div class="article-banner">
            <img src={article.cover_image} alt="" />
          </div>
        ) : (
          <div class="article-banner article-banner-grad" style={categoryGradStyle}>
            <span class="banner-cat-name" style={categoryNameStyle}>
              {category?.name || '✦'}
            </span>
          </div>
        )}
        <div class="article-meta-top" data-reveal="fade-up">
          {category && (
            <a
              href={`/categories/${encodeURIComponent(category.slug)}`}
              class="article-category"
              style={categoryBadgeStyle}
            >
              {category.name}
            </a>
          )}
          {publishedAt && (
            <time class="article-date" datetime={publishedAt} data-article-date>
              {publishedLabel}
            </time>
          )}
        </div>
        <h1 class="article-title" data-reveal="fade-up">{article.title}</h1>
        {article.summary && (
          <p class="article-summary" data-reveal="fade-up">{article.summary}</p>
        )}
        <div class="article-meta-bottom" data-reveal="fade-up">
          <span class="meta-item">
            {article.view_count} <span data-i18n="article.views">次阅读</span>
          </span>
          <span class="meta-item">
            {article.like_count} <span data-i18n="article.likes">赞</span>
          </span>
          <span class="meta-item">
            {article.reading_time} <span data-i18n="article.minutes_read">分钟</span>
          </span>
        </div>
        <div class="article-tags" data-reveal="fade-up">
          {tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag.slug)}`} class="article-tag">
              {tag.name}
            </a>
          ))}
        </div>
      </header>
      <div class="article-content prose" set:html={bodyHtml}></div>
      <div class="article-actions">
        <div
          id="like-button-mount"
          data-article-id={article.id}
          data-like-count={article.like_count}
        ></div>
      </div>
      <div id="comment-section-mount" data-article-id={article.id}></div>
    </article>
  ) : (
    <div class="article-detail article-not-found" id="article-detail">
      {result.status === 'not-found' ? (
        <>
          <h2 data-i18n="article.not_found">文章未找到</h2>
          <p data-i18n="article.check_link">请检查链接是否正确</p>
          <a href="/" class="back-link" data-i18n="article.back_home">返回首页</a>
        </>
      ) : (
        <>
          <h2 data-i18n="article.load_error">加载失败，请刷新重试</h2>
          <p data-i18n="article.server_error">服务暂时不可用，请稍后重试。</p>
          <a
            href={Astro.url.pathname}
            class="back-link"
            data-i18n="article.retry"
          >
            重试
          </a>
        </>
      )}
    </div>
  )}
</BaseLayout>

<script>
  import { formatArticleDate } from '../../utils/articleDate';
  import { enhanceMediaLinks } from '../../utils/mediaEmbed';
  import { createApp } from 'vue';

  function articleIdFrom(el: HTMLElement | null): number | null {
    const id = Number(el?.dataset.articleId);
    return Number.isInteger(id) && id > 0 ? id : null;
  }

  async function mountVueComponents() {
    const likeMount = document.getElementById('like-button-mount');
    if (likeMount && !likeMount.dataset.mounted) {
      const articleId = articleIdFrom(likeMount);
      if (articleId !== null) {
        likeMount.dataset.mounted = '1';
        const { default: LikeButton } = await import('../../islands/LikeButton.vue');
        createApp(LikeButton, {
          articleId,
          initialCount: Number(likeMount.dataset.likeCount || 0),
        }).mount(likeMount);
      }
    }

    const commentMount = document.getElementById('comment-section-mount');
    if (commentMount && !commentMount.dataset.mounted) {
      const articleId = articleIdFrom(commentMount);
      if (articleId !== null) {
        commentMount.dataset.mounted = '1';
        const { default: CommentSection } = await import('../../islands/CommentSection.vue');
        createApp(CommentSection, { articleId }).mount(commentMount);
      }
    }
  }

  function refreshArticleDates() {
    // BaseLayout 在 <head> 内同步写入 data-locale，早于任何模块脚本；
    // 用它而不是 getLocale()，避免首屏 locale 初始化尚未完成时的语言竞态。
    const locale =
      document.documentElement.getAttribute('data-locale') === 'en' ? 'en' : 'zh';
    document.querySelectorAll<HTMLTimeElement>('time[data-article-date]').forEach((el) => {
      const iso = el.getAttribute('datetime');
      if (!iso) return;
      const label = formatArticleDate(iso, locale);
      if (label) el.textContent = label;
    });
  }

  function enhanceCodeBlocks(root: HTMLElement) {
    root.querySelectorAll('pre').forEach((pre) => {
      if ((pre as HTMLElement).dataset.enhanced) return;
      (pre as HTMLElement).dataset.enhanced = '1';
      const code = pre.querySelector('code');
      const langMatch = code?.className.match(/language-([\w+-]+)/);
      const lang = langMatch ? langMatch[1] : '';
      const bar = document.createElement('div');
      bar.className = 'code-bar';
      if (lang) {
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        bar.appendChild(label);
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = '复制';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code?.textContent || pre.textContent || '');
          btn.textContent = '已复制';
        } catch {
          btn.textContent = '复制失败';
        }
        setTimeout(() => (btn.textContent = '复制'), 1600);
      });
      bar.appendChild(btn);
      pre.prepend(bar);
    });
  }

  /* ===== 媒体 / 网页链接增强：统一内嵌容器（src/utils/mediaEmbed.ts） ===== */
  // 音频 / 视频文件 / B 站 / YouTube 链接自动识别，编辑器标记 data-embed="1"
  // 的任意链接渲染为内嵌网页预览；不可内嵌的自动降级为普通链接。
  function currentLocale(): string {
    return document.documentElement.getAttribute('data-locale') === 'en'
      ? 'en'
      : 'zh';
  }

  // 正文已由 SSR 输出；脚本只挂载点赞 / 评论岛屿并做阅读增强。
  // ClientRouter 客户端导航不重跑已执行过的模块脚本，初始化挂 astro:page-load（首次硬加载也触发）。
  document.addEventListener('astro:page-load', () => {
    const article = document.getElementById('article-detail');
    if (article) {
      enhanceCodeBlocks(article);
      enhanceMediaLinks(article, '.prose a[href]', currentLocale());
    }
    refreshArticleDates();
    void mountVueComponents();
  });

  document.addEventListener('locale-changed', refreshArticleDates);
</script>

<style is:global>
  .article-detail {
    --card-pad: clamp(1rem, 3vw, 2rem);
    max-width: min(760px, 100%);
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--card-pad);
    box-shadow: var(--shadow-md);
    min-width: 0;
  }

  .article-header {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .article-banner {
    margin: calc(-1 * var(--card-pad)) calc(-1 * var(--card-pad)) 1.5rem;
    border-radius: calc(var(--radius-lg) - 2px) calc(var(--radius-lg) - 2px) 0 0;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .article-banner img {
    width: 100%;
    max-height: clamp(200px, 40vw, 360px);
    object-fit: cover;
  }

  .article-meta-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    min-width: 0;
  }

  .article-category {
    display: inline-block;
    max-width: 100%;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--cat-bg);
    color: var(--cat-fg);
    border: 1px solid var(--cat-bd);
    transition: filter var(--transition-fast);
  }

  [data-theme="dark"] .article-category {
    background: var(--cat-bg-d);
    color: var(--cat-fg-d);
    border-color: var(--cat-bd-d);
  }

  .article-category:hover {
    filter: brightness(0.9);
  }

  .article-banner-grad {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(140px, 28vw, 200px);
    background: var(--grad-l);
  }

  [data-theme="dark"] .article-banner-grad {
    background: var(--grad-d);
  }

  .banner-cat-name {
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    max-width: 90%;
    overflow-wrap: anywhere;
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0.95;
    color: var(--catname-l);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.55), 0 0 26px rgba(255, 255, 255, 0.3);
  }

  [data-theme="dark"] .banner-cat-name {
    color: var(--catname-d);
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.5), 0 0 24px rgba(255, 255, 255, 0.2);
  }

  .article-date {
    color: var(--color-text-tertiary);
  }

  .article-title {
    font-size: clamp(1.4rem, 4.5vw, 2rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    overflow-wrap: anywhere;
  }

  .article-summary {
    font-size: clamp(1rem, 1.5vw, 1.05rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .article-meta-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--color-text-tertiary);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-tag {
    padding: 0.15rem 0.6rem;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    transition: all var(--transition-fast);
  }

  .article-tag:hover {
    background-color: var(--color-tag-hover-bg);
    color: var(--color-tag-hover-text);
  }

  .article-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  .article-not-found {
    text-align: center;
    padding: clamp(2.5rem, 8vw, 4rem) 0;
    color: var(--color-text-secondary);
  }

  .article-not-found h2 {
    font-size: clamp(1.3rem, 3.5vw, 1.5rem);
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    overflow-wrap: anywhere;
  }

  .article-not-found p {
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.2rem;
    background-color: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .back-link:hover {
    background-color: var(--color-accent-hover);
    color: #fff;
  }

  /* 文章媒体卡片样式已迁移至 src/styles/media-embed.css（与后台编辑器预览共用） */

  @media (max-width: 480px) {

  /* 矮横屏：压缩头图，别让 375px 高的视口只剩一张封面 */
  @media (orientation: landscape) and (max-height: 500px) {
    .article-header {
      margin-bottom: 1rem;
    }
    .article-banner {
      margin-bottom: 1rem;
    }
    .article-banner img {
      max-height: 120px;
    }
    .article-banner-grad {
      min-height: clamp(88px, 30vh, 120px);
    }
    .article-title {
      font-size: clamp(1.3rem, 3.5vw, 1.6rem);
    }
  }
</style>
